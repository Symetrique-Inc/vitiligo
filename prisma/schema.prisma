generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("SUPER_ADMIN") // SUPER_ADMIN, TRANSLATOR, VIEWER
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SupportedLanguage {
  code        String        @id // en, hi, mr, bn, ta, te, kn
  name        String        // English, Hindi, etc.
  nativeName  String        // English, हिन्दी, etc.
  scriptName  String?       // Devanagari, Bengali, Tamil, etc.
  isEnabled   Boolean       @default(true)
  isDefault   Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  translations Translation[]
}

model TranslationKey {
  id            String        @id @default(cuid())
  key           String        @unique // unique identifier e.g. VTH-00002 or home.hero.title
  page          String        // page identifier e.g. home, about, understand-vitiligo, living-with-vitiligo, etc.
  section       String        // section e.g. hero, navigation, footer, myths, etc.
  component     String?       // component name e.g. Header, LandingHero, etc.
  description   String?       // contextual guidance for translators
  sourceText    String        // English source text
  sourceVersion Int           @default(1)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  translations  Translation[]

  @@index([page])
  @@index([section])
  @@index([key])
}

model Translation {
  id               String               @id @default(cuid())
  translationKeyId String
  languageCode     String
  translatedText   String               // Current working draft / edited translation
  status           String               @default("DRAFT") // MISSING, DRAFT, IN_REVIEW, APPROVED, PUBLISHED
  isPublished      Boolean              @default(false)
  publishedText    String?              // Latest published live version
  version          Int                  @default(1)
  updatedBy        String               @default("Super Admin")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  publishedAt      DateTime?
  
  translationKey   TranslationKey       @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)
  language         SupportedLanguage    @relation(fields: [languageCode], references: [code], onDelete: Cascade)
  history          TranslationHistory[]

  @@unique([translationKeyId, languageCode])
  @@index([languageCode])
  @@index([status])
  @@index([isPublished])
}

model TranslationHistory {
  id             String      @id @default(cuid())
  translationId  String
  previousText   String?
  newText        String
  previousStatus String?
  newStatus      String
  changedBy      String      @default("Super Admin")
  changeReason   String?     // e.g. "Initial AI Migration", "Manual Edit", "Approved", "Published", "Reverted"
  createdAt      DateTime    @default(now())

  translation    Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId])
  @@index([createdAt])
}

model TranslationPublishLog {
  id           String   @id @default(cuid())
  scope        String   // ALL, PAGE, LANGUAGE, SINGLE
  page         String?
  languageCode String?
  publishedBy  String   @default("Super Admin")
  changesCount Int
  details      String?  // JSON string of summary
  publishedAt  DateTime @default(now())

  @@index([publishedAt])
  @@index([languageCode])
  @@index([page])
}

